<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the GitHub artifact uploaded by release.yml
     contains Macaw-<version>-setup.exe. Paste this into SignPath. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Macaw-*-setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
